@model Corno.Data.Corno.Question_Bank_V2.Dtos.SetterDashboardDto
@{
    ViewBag.Title = "Question Setter Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2 class="page-header">
                <i class="fa fa-user-edit"></i> Question Setter Dashboard
            </h2>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-3">
                            <i class="fa fa-question-circle fa-5x"></i>
                        </div>
                        <div class="col-xs-9 text-right">
                            <div class="huge">@Model.TotalQuestions</div>
                            <div>My Questions</div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "QB_QuestionBank")">
                    <div class="panel-footer">
                        <span class="pull-left">View All</span>
                        <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>
                        <div class="clearfix"></div>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="panel panel-yellow">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-3">
                            <i class="fa fa-edit fa-5x"></i>
                        </div>
                        <div class="col-xs-9 text-right">
                            <div class="huge">@Model.PendingQuestions</div>
                            <div>Draft Questions</div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "QB_QuestionBank", new { status = "Draft" })">
                    <div class="panel-footer">
                        <span class="pull-left">Continue Editing</span>
                        <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>
                        <div class="clearfix"></div>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-3">
                            <i class="fa fa-paper-plane fa-5x"></i>
                        </div>
                        <div class="col-xs-9 text-right">
                            <div class="huge">@Model.SubmittedQuestions</div>
                            <div>Submitted</div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "QB_QuestionBank", new { status = "Submitted" })">
                    <div class="panel-footer">
                        <span class="pull-left">View Details</span>
                        <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>
                        <div class="clearfix"></div>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="panel panel-green">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-3">
                            <i class="fa fa-check-circle fa-5x"></i>
                        </div>
                        <div class="col-xs-9 text-right">
                            <div class="huge">@Model.ApprovedQuestions</div>
                            <div>Approved</div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "QB_QuestionBank", new { status = "Approved" })">
                    <div class="panel-footer">
                        <span class="pull-left">View Details</span>
                        <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>
                        <div class="clearfix"></div>
                    </div>
                </a>
            </div>
        </div>
    </div>
    
    @if (Model.RecentAppointments != null && Model.RecentAppointments.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Recent Appointments</h4>
                    </div>
                    <div class="panel-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Appointment Code</th>
                                    <th>Subject</th>
                                    <th>No. of Papers</th>
                                    <th>Deadline</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td>@appointment.AppointmentCode</td>
                                        <td>@appointment.SubjectName</td>
                                        <td>@appointment.NoOfPapers</td>
                                        <td>@(appointment.AppointmentDate?.ToString("dd/MM/yyyy") ?? "")</td>
                                        <td>
                                            <span class="label label-@(appointment.Status == "Completed" ? "success" : "warning")">
                                                @appointment.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .huge {
        font-size: 40px;
    }
</style>
