@model Corno.Data.Corno.Question_Bank_V2.Models.QB_QuestionBank

@{
    ViewBag.Title = "Create Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "QB_QuestionBank", FormMethod.Post, new { @class = "form-horizontal", id = "questionForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <h3 class="page-header">
                    <i class="fa fa-plus-circle"></i> Create Question
                </h3>
            </div>
        </div>
        
        <!-- Context Selection -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">Context Selection</h4>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.InstanceId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.InstanceId, ViewBag.Instances as SelectList, "Select Instance", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.InstanceId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.FacultyId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.FacultyId, ViewBag.Faculties as SelectList, "Select Faculty", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.FacultyId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.CourseId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.CourseId, ViewBag.Courses as SelectList, "Select Course", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.CourseId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.SubjectId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.SubjectId, ViewBag.Subjects as SelectList, "Select Subject", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.SubjectId)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Question Content -->
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h4 class="panel-title">Question Content</h4>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.QuestionText, new { @class = "control-label" })
                            <span class="text-danger">*</span>
                            @(Html.Telerik().EditorFor(m => m.QuestionText)
                                .Name("QuestionText")
                                .Tools(tools => tools
                                    .Clear()
                                    .Bold().Italic().Underline()
                                    .FontName().FontSize()
                                    .ForeColor().BackColor()
                                    .JustifyLeft().JustifyCenter().JustifyRight()
                                    .InsertOrderedList().InsertUnorderedList()
                                    .Indent().Outdent()
                                    .CreateLink().Unlink()
                                    .InsertImage()
                                    .TableEditing()
                                    .FormatBlock()
                                )
                                .Value(Model != null ? Model.QuestionText : "")
                                .HtmlAttributes(new { style = "min-height:400px;" })
                            )
                            @Html.ValidationMessageFor(m => m.QuestionText)
                            <small class="help-block">Use the toolbar to insert formulas, images, tables, and format text.</small>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.QuestionTypeId, new { @class = "control-label" })
                            <span class="text-danger">*</span>
                            @Html.DropDownListFor(m => m.QuestionTypeId, ViewBag.QuestionTypes as SelectList, "Select Type", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.QuestionTypeId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.UnitId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.UnitId, ViewBag.Units as SelectList, "Select Unit", 
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.UnitId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.DifficultyLevelId, new { @class = "control-label" })
                            <span class="text-danger">*</span>
                            @Html.DropDownListFor(m => m.DifficultyLevelId, ViewBag.DifficultyLevels as SelectList, "Select Difficulty", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.DifficultyLevelId)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TaxonomyLevelId, new { @class = "control-label" })
                            <span class="text-danger">*</span>
                            @Html.DropDownListFor(m => m.TaxonomyLevelId, ViewBag.TaxonomyLevels as SelectList, "Select Taxonomy", 
                                new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(m => m.TaxonomyLevelId)
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Marks, new { @class = "control-label" })
                            <span class="text-danger">*</span>
                            @Html.TextBoxFor(m => m.Marks, new { @class = "form-control", type = "number", step = "0.5", @required = "required" })
                            @Html.ValidationMessageFor(m => m.Marks)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TimeAllotted, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.TimeAllotted, new { @class = "form-control", type = "number", placeholder = "Minutes" })
                            @Html.ValidationMessageFor(m => m.TimeAllotted)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Tags, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Tags, new { @class = "form-control", placeholder = "Comma separated tags" })
                            @Html.ValidationMessageFor(m => m.Tags)
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Keywords, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Keywords, new { @class = "form-control", placeholder = "Comma separated keywords" })
                            @Html.ValidationMessageFor(m => m.Keywords)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Model Answer -->
        <div class="panel panel-info">
            <div class="panel-heading">
                <h4 class="panel-title">Model Answer</h4>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ModelAnswer, new { @class = "control-label" })
                            @(Html.Telerik().EditorFor(m => m.ModelAnswer)
                                .Name("ModelAnswer")
                                .Tools(tools => tools
                                    .Clear()
                                    .Bold().Italic().Underline()
                                    .FontName().FontSize()
                                    .ForeColor().BackColor()
                                    .JustifyLeft().JustifyCenter().JustifyRight()
                                    .InsertOrderedList().InsertUnorderedList()
                                    .Indent().Outdent()
                                    .CreateLink().Unlink()
                                    .InsertImage()
                                    .TableEditing()
                                    .FormatBlock()
                                )
                                .Value(Model != null ? Model.ModelAnswer : "")
                                .HtmlAttributes(new { style = "min-height:300px;" })
                            )
                            @Html.ValidationMessageFor(m => m.ModelAnswer)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" name="action" value="SaveDraft" class="btn btn-secondary">
                        <i class="fa fa-save"></i> Save as Draft
                    </button>
                    <button type="submit" name="action" value="SubmitForCheck" class="btn btn-primary">
                        <i class="fa fa-paper-plane"></i> Submit for Check
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-default">
                        <i class="fa fa-times"></i> Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Handle form submission - get data from Telerik editors
            $('#questionForm').on('submit', function (e) {
                var questionEditor = $('#QuestionText').data('tEditor');
                var answerEditor = $('#ModelAnswer').data('tEditor');
                
                if (questionEditor) {
                    $('#QuestionText').val(questionEditor.value());
                }
                
                if (answerEditor) {
                    $('#ModelAnswer').val(answerEditor.value());
                }
            });
        });
    </script>
}
